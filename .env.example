# ==============================================================================
# SENTINEL Production & Staging Environment Configuration
# ==============================================================================

# --- Operating Mode ---
SENTINEL_OFFLINE=false              # false = live online intelligence (with resilient local snapshot fallbacks)
SENTINEL_SEED=false                 # false = clean production database; true = seed initial SOC triage samples
SENTINEL_REQUIRE_AUTH=true          # true = strictly enforce signed JWT / API-key RBAC on privileged operations

# --- Storage & Database ---
SENTINEL_DB_PATH=data/sentinel.db   # SQLite storage location (defaults to data/sentinel.db)
DATABASE_URL=                       # PostgreSQL connection URL (optional, e.g. postgresql://user:pass@localhost:5432/sentinel)

# --- Authentication & RBAC (Production) ---
SENTINEL_JWT_SECRET=                # High-entropy secret for HMAC-SHA256 JWT tokens (generated automatically by deploy.sh)
SENTINEL_JWT_EXPIRE_SECONDS=86400   # Token validity duration (default: 24h = 86400s)
SENTINEL_ADMIN_PASSWORD=changeme123 # Initial password for 'admin' user (CHANGE BEFORE PRODUCTION DEPLOYMENT!)
SENTINEL_API_KEY=                   # Optional shared API key for backward-compatible server-to-server auth

# --- CORS & Security Headers ---
SENTINEL_CORS_ORIGINS=              # Comma-separated allowed origins (e.g., https://sentinel.yourdomain.com,http://localhost:3000)

# --- Logging & Telemetry ---
SENTINEL_LOG_LEVEL=INFO              # Log level: DEBUG, INFO, WARNING, ERROR

# --- AI / LLM Provider (Module 3) ---
GEMINI_API_KEY=                     # Google Gemini API key (recommended for multilingual reasoning)
GOOGLE_API_KEY=                     # Alternative Google AI API key

# --- Threat Intelligence Feeds (Module 1) ---
GSB_API_KEY=                        # Google Safe Browsing API v4 key
VT_API_KEY=                         # VirusTotal v3 API key
URLHAUS_AUTH_KEY=                   # abuse.ch Auth-Key for URLhaus API
PHISHTANK_APP_KEY=                  # PhishTank registered developer key

# --- Decentralized Intelligence / EVM Smart Contract (Module 6) ---
RPC_URL=https://rpc.sepolia.org     # EVM JSON-RPC URL (Sepolia, Amoy, or http://127.0.0.1:8545)
CHAIN_NAME=sepolia                  # Network label (sepolia, amoy, hardhat)
CONTRACT_ADDRESS=                   # Deployed ReportRegistry.sol contract address
CHAIN_PRIVATE_KEY=                  # Testnet deployer/signer wallet private key (NEVER use mainnet keys)
